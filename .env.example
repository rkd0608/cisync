# CISync dev environment (NEVER real secrets)
CISYNC_INGEST_PG_DSN=postgres://cisync:cisync_dev_only@localhost:5432/cisync
CISYNC_INGEST_WEBHOOK_SECRET=dev_webhook_secret_not_for_prod
CISYNC_INGEST_ADDR=:8080
CISYNC_CTRL_PG_DSN=postgres://cisync:cisync_dev_only@localhost:5432/cisync
CISYNC_CTRL_ADDR=:8081
CISYNC_CTRL_FLEET_URL=http://localhost:8082
CISYNC_CTRL_LEDGER_KEY_FILE=./platform/dev-keys/ledger_ed25519.dev.key
CISYNC_CTRL_ADMIN_TOKEN=dev_admin_token_not_for_prod
CISYNC_FLEET_PG_DSN=postgres://cisync:cisync_dev_only@localhost:5432/cisync
CISYNC_FLEET_ADDR=:8082
CISYNC_FLEET_PROVIDER=sim
# Web console API base (apps/web). Keep UNSET in production: the browser then
# uses same-origin /api/cisync and the Next.js route handler injects the admin
# bearer server-side (tokens must never reach the client bundle). Override
# ONLY for local browser-to-ctrl debugging.
# NEXT_PUBLIC_CISYNC_API_URL=http://localhost:8081
CISYNC_CTRL_CONNECTOR_URL=http://localhost:8083
CISYNC_CONN_PG_DSN=postgres://cisync:cisync_dev_only@localhost:5432/cisync
CISYNC_CONN_ADDR=:8083
CISYNC_CONN_WEBHOOK_SECRET=dev_webhook_secret_not_for_prod
# Optional GitHub App creds; when ALL are absent the connector runs dry-run.
# CISYNC_CONN_GITHUB_APP_ID=
# CISYNC_CONN_GITHUB_APP_PRIVATE_KEY_FILE=
# CISYNC_CONN_GITHUB_INSTALLATION_ID=

# --- GitHub App (v0.2 connect flow) ---
# Public install page for your registered App: https://github.com/apps/<slug>/installations/new
# NEXT_PUBLIC_CISYNC_GITHUB_APP_INSTALL_URL=
# Connector live-mode credentials (absent = dry-run check logging):
# CISYNC_CONN_GITHUB_APP_ID=
# CISYNC_CONN_PRIVATE_KEY_FILE=./platform/dev-keys/github-app.dev.pem
# CISYNC_CONN_INSTALLATION_ID=
# CISYNC_CONN_DETAILS_URL=http://localhost:3000

# --- Web auth (apps/web): email+password via control-plane (SPEC §3 2026-08-26) ---
# DEDICATED Ed25519 private key signing stateless 30d session JWTs. NEVER reuse
# the ledger or job-lease key (trust-domain separation, B2 pattern). Generate:
#   openssl genpkey -algorithm ed25519 -out ./platform/dev-keys/session_ed25519.dev.key
#   openssl pkey -in <key> -pubout -out ./platform/dev-keys/session_ed25519.dev.pub
CISYNC_SESSION_KEY_FILE=./platform/dev-keys/session_ed25519.dev.key
# Signup posture consumed by the /login page server-side:
#   open   → form offers "create account"
#   invite → sign-ups invite-only copy shown (DEFAULT if unset)
#   closed → registration disabled copy shown
CISYNC_SIGNUP_MODE=open
