# Sauron dev environment (NEVER real secrets)
SAURON_INGEST_PG_DSN=postgres://sauron:sauron_dev_only@localhost:5432/sauron
SAURON_INGEST_WEBHOOK_SECRET=dev_webhook_secret_not_for_prod
SAURON_INGEST_ADDR=:8080
SAURON_CTRL_PG_DSN=postgres://sauron:sauron_dev_only@localhost:5432/sauron
SAURON_CTRL_ADDR=:8081
SAURON_CTRL_FLEET_URL=http://localhost:8082
SAURON_CTRL_LEDGER_KEY_FILE=./platform/dev-keys/ledger_ed25519.dev.key
SAURON_CTRL_ADMIN_TOKEN=dev_admin_token_not_for_prod
SAURON_FLEET_PG_DSN=postgres://sauron:sauron_dev_only@localhost:5432/sauron
SAURON_FLEET_ADDR=:8082
SAURON_FLEET_PROVIDER=sim
NEXT_PUBLIC_SAURON_API_URL=http://localhost:8081
SAURON_CTRL_CONNECTOR_URL=http://localhost:8083
SAURON_CONN_PG_DSN=postgres://sauron:sauron_dev_only@localhost:5432/sauron
SAURON_CONN_ADDR=:8083
SAURON_CONN_WEBHOOK_SECRET=dev_webhook_secret_not_for_prod
# Optional GitHub App creds; when ALL are absent the connector runs dry-run.
# SAURON_CONN_GITHUB_APP_ID=
# SAURON_CONN_GITHUB_APP_PRIVATE_KEY_FILE=
# SAURON_CONN_GITHUB_INSTALLATION_ID=

# --- GitHub App (v0.2 connect flow) ---
# Public install page for your registered App: https://github.com/apps/<slug>/installations/new
# NEXT_PUBLIC_SAURON_GITHUB_APP_INSTALL_URL=
# Connector live-mode credentials (absent = dry-run check logging):
# SAURON_CONN_GITHUB_APP_ID=
# SAURON_CONN_PRIVATE_KEY_FILE=./platform/dev-keys/github-app.dev.pem
# SAURON_CONN_INSTALLATION_ID=
