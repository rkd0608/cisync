{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd apps/web && pnpm install --frozen-lockfile --dangerously-allow-all-builds && pnpm build",
  "outputDirectory": "apps/web/.next",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/apps/web/$1" }
  ]
}
