# Sauron Phase-1 prod env — Oracle Always-Free (platform/deploy/oracle/).
# cp .env.prod.example .env.prod && fill EVERY value below. chmod 600.
# NEVER commit .env.prod. Every value is single-source: compose interpolates
# ${VAR} from this file into service environments.

# ── Public host ──────────────────────────────────────────────────────────
# DNS A record -> instance public IP (RUNBOOK-oracle §5). No scheme/port.
DOMAIN=sauron.example.com
# Let's Encrypt renewal notices; required for automatic HTTPS.
ACME_EMAIL=ops@example.com

# ── Postgres ─────────────────────────────────────────────────────────────
# generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# ── GitHub webhook HMAC secret (ingest + ctrl + connector must MATCH) ────
# Same value goes into the GitHub App "Webhook secret" field.
# generate: openssl rand -hex 32
SAURON_INGEST_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32
SAURON_CTRL_WEBHOOK_SECRET=CHANGE_ME_same_value_as_above
SAURON_CONN_WEBHOOK_SECRET=CHANGE_ME_same_value_as_above
# ROTATION (zero-downtime, docs/RUNBOOK.md §4): during the ≤24h dual window,
# set SAURON_INGEST_WEBHOOK_SECRETS="NEW,OLD" in addition to the vars above,
# `docker compose ... up -d ingest`, flip the secret in GitHub App settings,
# then drop the plural var after the window. Alert if overlap exceeds 24h.

# ── Admin token (control-plane API + web proxy + connector status) ───────
# Single-admin posture for phase 1 (ARCHITECTURE v1 cut: RBAC = v0.3).
# generate: openssl rand -hex 32
SAURON_CTRL_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32
SAURON_CONN_ADMIN_TOKEN=CHANGE_ME_same_value_as_above

# ── Ed25519 signing keys (mounted ro at /keys) ───────────────────────────
# Files expected in ./keys/ next to this dir's compose file:
#   ledger_ed25519.key      ledger checkpoint signing (D10: ctrl-ONLY)
#   joblease_ed25519.key    job-lease signing (B2/I-04: dedicated, NEVER the
#                           ledger key)
#   joblease_ed25519.pub    public half, read by runner-fleet
#
# generate (from platform/deploy/oracle/):
#   mkdir -p keys && chmod 700 keys
#   openssl genpkey -algorithm ed25519 -out keys/ledger_ed25519.key
#   openssl genpkey -algorithm ed25519 -out keys/joblease_ed25519.key
#   openssl pkey -in keys/joblease_ed25519.key -pubout -out keys/joblease_ed25519.pub
#   chmod 600 keys/*.key && chmod 644 keys/*.pub
# BACK THE PRIVATE KEYS UP OFF-BOX (age-encrypt + R2): losing the ledger key
# does NOT lose data (old checkpoints stay verifiable with archived pubkeys),
# but new checkpoints would be unverifiable against a rotated key without a
# documented rotation note.

# ── Ledger integrity (I-07/H3) & audit ───────────────────────────────────
# In-process chain verifier cadence (same code as `verify` subcommand).
SAURON_CTRL_VERIFY_INTERVAL=24h
# B7 security_audit retention; hard floor 90d enforced by config loader.
SAURON_CTRL_AUDIT_RETENTION_DAYS=180
# Tracked base branches driving merge_base.advanced supersede cascades.
SAURON_CTRL_TRACKED_BASE_BRANCHES=main,master

# ── Backup encryption + off-site (backup.sh / restore.sh) ────────────────
# install age on the HOST: sudo apt-get install -y age   (see backup.sh WHY)
# generate keypair ON the host: age-keygen -o age.key && chmod 600 age.key
# then paste the PUBLIC key line it prints:
AGE_PUBLIC_KEY=age1_CHANGE_ME_output_of_age_keygen
# Path to the identity file for restore drills (used by cron-adjacent shells):
# AGE_PRIVATE_KEY_FILE=/home/ubuntu/sauron-keys/age.key
# Cloudflare R2 remote (setup steps inline in backup.sh header). Leave empty
# to run local-only backups — NOT recommended (backups are THE feature, I-07).
RCLONE_REMOTE=
